# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

PORT=3000

# --- Seguridad (Reto 3) ---
# OBLIGATORIA. Clave de la API: se exige en el encabezado x-api-key para POST, PUT y DELETE.
# Mínimo 16 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=

# Orígenes (sitios web) que el navegador puede usar para llamar a la API, separados por comas.
# La página propia no lo necesita (mismo origen). Nunca se usa "*".
ORIGENES_PERMITIDOS=http://localhost:3000

# --- Logs (Reto 3) ---
# error | warn | info | http | debug. Con "http" se registra cada petición.
LOG_LEVEL=http

# Parte 3: URL donde se envían las notificaciones (por ejemplo tu enlace de webhook.site).
# Déjala vacía si no quieres enviar nada.
URL_API_EXTERNA=

# Tabla "catalogo" (canciones descargadas de la API de Deezer)
# Canciones que se piden al iniciar el servidor (máximo 100, que es lo que entrega Deezer por petición).
CARGA_INICIAL=100
# Tope de canciones del comando/botón "Obtener todo" (ranking global + ranking de cada género).
CARGA_COMPLETA=5000
# "si": al iniciar, si la tabla catalogo está vacía, pide las canciones iniciales a la API. "no": no descarga nada.
CARGA_AL_INICIAR=si
