{
  "name": "reto1-reproductor-deezer",
  "version": "3.0.0",
  "description": "Ritmo: API REST con Deezer (Reto 1), persistencia CRUD (Reto 2) y observabilidad, seguridad y pruebas de integración (Reto 3)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "catalogo:estado": "node scripts/catalogo.js estado",
    "catalogo:obtener": "node scripts/catalogo.js obtener",
    "catalogo:borrar": "node scripts/catalogo.js borrar",
    "catalogo:reiniciar": "node scripts/catalogo.js reiniciar",
    "test:reto1": "node --test test/musica.test.js",
    "test:reto2": "node --test test/favoritos.test.js test/catalogo.test.js",
    "test:reto3": "node --test test/observabilidad.test.js test/seguridad.test.js",
    "test:unitarias": "node --test test/musica.test.js test/favoritos.test.js test/catalogo.test.js test/observabilidad.test.js test/seguridad.test.js",
    "test:integracion": "node --test test/integracion.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "winston": "^3.17.0"
  }
}
