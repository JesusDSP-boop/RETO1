{
  "info": {
    "name": "Reto 2 - Favoritos (CRUD + API externa)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "favoritoId",
      "value": "1"
    },
    {
      "key": "usuario",
      "value": "cliente1"
    },
    {
      "key": "password",
      "value": "cambia-esta-clave-123"
    }
  ],
  "item": [
    {
    "name": "1. POST registrar cliente (una sola vez)",
    "request": {
      "method": "POST",
      "header": [
        { "key": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mode": "raw",
        "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"{{password}}\"\n}"
      },
      "url": {
        "raw": "{{baseUrl}}/api/auth/registro",
        "host": ["{{baseUrl}}"],
        "path": ["api", "auth", "registro"]
      }
    }
    },
    {
    "name": "2. POST iniciar sesión cliente",
    "request": {
      "method": "POST",
      "header": [
        { "key": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mode": "raw",
        "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"{{password}}\"\n}"
      },
      "url": {
        "raw": "{{baseUrl}}/api/auth/login",
        "host": ["{{baseUrl}}"],
        "path": ["api", "auth", "login"]
      }
    }
    },
    {
    "name": "3. POST crear favorito (sin API key)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('favoritoId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 3135556,\n  \"titulo\": \"Harder, Better, Faster, Stronger\",\n  \"artista\": \"Daft Punk\",\n  \"album\": \"Discovery\",\n  \"portada\": \"https://ejemplo.com/portada.jpg\",\n  \"duracion\": 224,\n  \"preview\": \"https://ejemplo.com/preview.mp3\",\n  \"enlace\": \"https://www.deezer.com/track/3135556\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/favoritos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "favoritos"
          ]
        }
      }
    },
    {
      "name": "4. GET listar favoritos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/favoritos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "favoritos"
          ]
        }
      }
    },
    {
      "name": "5. GET favorito por id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/favoritos/{{favoritoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "favoritos",
            "{{favoritoId}}"
          ]
        }
      }
    },
    {
      "name": "6. PUT editar nombre y notas (sin API key)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Harder, Better (mi versión)\",\n  \"notas\": \"Para entrenar\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/favoritos/{{favoritoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "favoritos",
            "{{favoritoId}}"
          ]
        }
      }
    },
    {
      "name": "7. DELETE eliminar favorito (sin API key)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/favoritos/{{favoritoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "favoritos",
            "{{favoritoId}}"
          ]
        },
        "header": []
      }
    }
  ]
}